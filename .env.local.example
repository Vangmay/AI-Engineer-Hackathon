# Copy to .env.local and fill in. Never commit real keys.

# Public frontend config
VITE_CONVEX_URL=

# Server-only provider keys. Do not prefix these with VITE_.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.5
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL_ID=
GEMINI_API_KEY=
FAL_API_KEY=
LYRIA_API_KEY=

# Optional fal model overrides
FAL_IMAGE_MODEL=fal-ai/flux-pro/kontext/max/text-to-image
FAL_IMAGE_TO_IMAGE_MODEL=fal-ai/flux-pro/kontext/max
FAL_SCENE_MODEL=fal-ai/flux-pro/kontext/max/text-to-image
FAL_IMAGE_TO_3D_MODEL=fal-ai/hunyuan3d-v3/image-to-3d
FAL_TEXT_TO_3D_MODEL=fal-ai/meshy/v6/text-to-3d

# Corpus pipeline caps
EXA_API_KEY=
CASE_DISCOVERY_MAX_RESULTS=50
SOURCE_FETCH_LIMIT=15
MEDIA_PER_PERSON_LIMIT=12

# Convex CLI/deployment config
CONVEX_DEPLOYMENT=
